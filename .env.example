# Public Supabase browser configuration (safe to expose, but restrict the project URL).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-side Supabase configuration.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

# Canonical HTTPS origin used for payment return/webhook URLs.
PUBLIC_APP_URL=https://cafe1luton.co.uk

# Exact 40-character Git commit deployed to production. This is public release metadata.
PUBLIC_RELEASE_SHA=replace-with-the-deployed-40-character-git-sha

# EVO semi-integrated card terminal settings (server-side only).
# Obtain these from EVO after the Café 1 merchant and lanes are boarded.
EVO_DIAMOND_PROFILE_ID=
EVO_DIAMOND_LANE_ID=
EVO_DIAMOND_POS_ID=
EVO_DIAMOND_SHARED_SECRET=

# At least 32 random characters; sent as: Authorization: Bearer <secret>
CRON_SECRET=replace-with-a-random-32-character-minimum-secret

# Required production connector credentials. Delivery fails closed when the
# server-side Maps connection is unavailable; Resend powers receipts, auth and
# the juror claim report. Keep these in the host secret manager only.
LOVABLE_API_KEY=
RESEND_API_KEY=
GOOGLE_MAPS_API_KEY=
# Public Google Place ID for Café 1. The server uses it to request attributed
# review data through Places API (New); never expose the API key itself.
GOOGLE_PLACE_ID=
# Optional public browser map configuration. Restrict this key to
# https://cafe1luton.co.uk/* and only the required browser APIs.
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=

# Optional privacy-gated GA4 measurement. Analytics stays disabled unless a
# valid G-XXXXXXXX ID is set and the visitor explicitly allows analytics.
VITE_GA_MEASUREMENT_ID=

# Public official profile and post URLs rendered on /socials. These VITE_
# values are intentionally browser-visible; never put access tokens here.
VITE_SOCIAL_FACEBOOK_URL=https://www.facebook.com/Cafe1luton
VITE_SOCIAL_INSTAGRAM_URL=https://www.instagram.com/cafe1luton/
VITE_SOCIAL_TIKTOK_URL=https://www.tiktok.com/@cafe1.luton
VITE_SOCIAL_YOUTUBE_URL=
VITE_SOCIAL_EMBEDS_JSON=[]

# Optional automatic social feeds. These values are server-only: never prefix
# the API key or access token with VITE_. Set exactly one YouTube source. A
# channel ID uses YouTube's public uploads feed and does not need an API key;
# playlist IDs and handles require YOUTUBE_API_KEY.
YOUTUBE_API_KEY=
YOUTUBE_UPLOADS_PLAYLIST_ID=
YOUTUBE_CHANNEL_ID=
YOUTUBE_CHANNEL_HANDLE=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_VERSION=v23.0
# Deliveroo order ingestion. Use `orders_api` for the official webhook,
# `hub_watcher` only as a shop-PC fallback, `dual` during migration, or
# `disabled`. Café 1 currently uses a tablet/device with automatic acceptance.
DELIVEROO_INGEST_MODE=disabled
DELIVEROO_SITE_MODE=tablet
DELIVEROO_API_ENV=production
DELIVEROO_CLIENT_ID=
DELIVEROO_CLIENT_SECRET=
DELIVEROO_WEBHOOK_SECRET=
# At least 32 random characters; required by hub_watcher/dual only.
DELIVEROO_BRIDGE_SECRET=

# Just Eat order ingestion. `hub_watcher` mirrors accepted Partner Centre
# orders, `webhook` enables the structured push endpoint, and `dual` allows
# both during a controlled migration. Keep disabled until the cafe PC and KDS
# acceptance test have passed.
JUSTEAT_INGEST_MODE=disabled
# At least 32 random characters; required by every enabled Just Eat mode.
JUSTEAT_BRIDGE_SECRET=

# Uber Eats Manager watcher. Crown Court only; orders are mirrored to its KDS.
UBEREATS_INGEST_MODE=disabled
# At least 32 random characters; required when the watcher is enabled.
UBEREATS_BRIDGE_SECRET=

# Localhost-only developer login. Never enable in production.
ENABLE_DEV_LOGIN=false
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
DEV_STAFF_EMAIL=
DEV_STAFF_PASSWORD=
DEV_DRIVER_EMAIL=
DEV_DRIVER_PASSWORD=
DEV_CUSTOMER_EMAIL=
DEV_CUSTOMER_PASSWORD=

# Shared HMCTS judges portal login password (rotate here, never in code).
JUDGE_LOGIN_PASSWORD=
