# Cafe1 — Deliveroo shop watcher settings.
#
# Copy this file to  deliveroo-hub-watcher.env  in the same folder and fill in
# the real values. That copy stays on the shop PC only; it is never uploaded.

# You can fill in BOTH logins. The device account is tried first because it
# never expires; the ordinary Hub login is only used if the device account
# cannot get in. Leave a pair blank if you do not have it.

# 1) PRIMARY — the device account the tablet uses (a username, not an email).
DEVICE_USERNAME=the-device-username
DEVICE_PASSWORD=the-device-password

# 2) BACKUP — your normal Restaurant Hub email login.
HUB_USERNAME=you@example.co.uk
HUB_PASSWORD=put-the-password-here

# The shared secret Cafe1 uses to accept orders from this PC.
DELIVEROO_BRIDGE_SECRET=put-the-bridge-secret-here

# Leave these alone unless told otherwise.
CAFE1_URL=https://cafe1stalbans.co.uk